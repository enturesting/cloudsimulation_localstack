# Terraform State and Plans
*.tfstate*
*.tfstate.backup
.terraform/
.terraform.lock.hcl
*tfplan*
register-ami-*-*.json

# Terraform Variables (exclude actual configs, keep templates)
# Terraform variable files (contain secrets) - TEMPORARILY COMMENTED FOR WORKFLOW
*.auto.tfvars
*.auto.tfvars.json
# But allow templates
!*.tfvars.template
!*.tfvars.example
# Secrets
.env
*.env

# IDE
.vscode/
.idea/
*.swp

# Logs
*.log
/logs/
# Docs
docs/.DS_Store
docs/node_modules/

# Go
bin/
*.exe
*.test
*.out

# Python
__pycache*
.pytest_cach*

# LocalStack data (exclude runtime data, keep structure)
localstack/*/data/
localstack/*/*.log
localstack/*/tmp/
# But allow directory structure and configs
!localstack/*/
!localstack/docker-compose*.yml

# Node.js
node_modules/

# zip 
*.zip